# Copy this file to .env and fill in real values. Never commit .env.

# --- SQL Server (same DB the frontend/RESTAPI_TAT use) ---
# For a named instance (e.g. "MYPC\SQLEXPRESS"), leave DB_PORT blank - the driver resolves the port
# via SQL Browser using the instance name instead. Only set DB_PORT for a default/unnamed instance.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SmartFarm_25May26
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Worker behavior ---
# Run once a day at this server-local time (HH:mm) + once at startup. GateCheck only decides a waiting crop
# after its day has ended (V20260929_03), so just after midnight is enough. Blank = use CYCLE_INTERVAL_MS below.
RUN_AT=00:05
# Only used when RUN_AT is blank (testing / demo), in ms.
CYCLE_INTERVAL_MS=1800000
# Optional: limit to one farm (e.g. while piloting). Blank = every farm with the toggle on.
FARM_CODE=
