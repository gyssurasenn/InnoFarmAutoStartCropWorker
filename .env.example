# Copy this file to .env and fill in real values. Never commit .env.

# --- SQL Server (same DB the frontend/RESTAPI_TAT use) ---
# For a named instance (e.g. "MYPC\SQLEXPRESS"), leave DB_PORT blank - the driver resolves the port
# via SQL Browser using the instance name instead. Only set DB_PORT for a default/unnamed instance.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SmartFarm_25May26
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Worker behavior ---
# How often to run one cycle (CreatePending then GateCheck), in ms. Agreed cadence: 30 minutes.
CYCLE_INTERVAL_MS=1800000
# Optional: limit to one farm (e.g. while piloting). Blank = every farm with the toggle on.
FARM_CODE=
